
---
const stamps = [
  "webcore",
  "made-by-hand",
  "purple-inside",
  "no-ai-feed",
  "my-site-my-rules",
  "best-with-tea",
  "still-wip",
  "touch-grass-later",
];
import { Image } from "astro:assets";
import furry from "../assets/asswolf_txt.gif";
import nyan from "../assets/nyan.png";
import flags from "../assets/flags.png";
import trans from "../assets/transrights.png"


import buttonGif from "../assets/adoptedbyegirl-88x31.gif?url";

const hrefPath = "/";
const altText = "AdoptedByEgirl";

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, "") : null;
const embedCodeServer = siteOrigin
  ? `<a href="${siteOrigin}${hrefPath}" target="_blank" rel="noreferrer">` +
    `<img src="${new URL(buttonGif, siteOrigin).toString()}" width="88" height="31" alt="${altText}" />` +
    `</a>`
  : null;
---

<div class="side">
  <div class="side-title">Stamps & Stuff</div>
   <div class="side-box" id="np">
  <div class="side-box-title">Now playing</div>
  <div class="side-box-body">
    <div style="display:flex; gap:10px; align-items:center;">
      <img id="np-art" alt="" width="56" height="56"
           style="border:1px solid rgba(255,255,255,.18); background: rgba(0,0,0,.2); object-fit:cover;" />
      <div>
        <div id="np-title" style="font-weight:800;">—</div>
        <div id="np-artist" class="mono" style="opacity:.8;">offline</div>
      </div>
    </div>
    
  </div>
    <div class="statusbox">
    <div class="statusrow">
      <span class="led on" id="status-led" aria-hidden="true"></span>
      <span><strong>Status:</strong><span id="status-text">Online</span></span>
    </div>
  </div>
</div>

<script is:inline>
  const API = "https://nowplaying-worker.adoptedbyegirl.workers.dev/now"; // your worker

  const title = document.getElementById("np-title");
  const artist = document.getElementById("np-artist");
  const art = document.getElementById("np-art");

  const statusText = document.getElementById("status-text"); // add these ids in your markup
  const statusLed = document.getElementById("status-led");

  const OFFLINE_AFTER_MS = 2 * 60 * 1000; // 2 minutes (tune this)

  function setOffline() {
    if (statusText) statusText.textContent = "Offline";
    if (statusLed) statusLed.classList.remove("on");
    title.textContent = "—";
    artist.textContent = "offline";
    art.removeAttribute("src");
  }

  function setOnline() {
    if (statusText) statusText.textContent = "Online";
    if (statusLed) statusLed.classList.add("on");
  }

  async function tick() {
    try {
      const res = await fetch(API, { cache: "no-store" });

      if (res.status === 204) {
        setOffline();
        return;
      }

      const data = await res.json();

      // Staleness check
      const updatedAt = data.updatedAt ? Date.parse(data.updatedAt) : 0;
      const age = Date.now() - updatedAt;
      if (!updatedAt || age > OFFLINE_AFTER_MS) {
        setOffline();
        return;
      }

      // Optional: treat paused as offline
      // trackState: 1 = playing, 2 = paused (YTMD) ([your payload)
      // If you want paused to be offline, uncomment:
      if (data.trackState !== 1 && data.trackState !== -1) {
  setOffline();
  return;
}

      setOnline();
      title.textContent = data.title || "—";
      artist.textContent = data.artist || "";
      if (data.thumbnail) art.src = data.thumbnail;
    } catch {
      setOffline();
    }
  }

  tick();
  setInterval(tick, 15000);
</script>


  <div class="stampgrid" aria-label="stamps">
    {stamps.map((s) => (
      <div class="stamp">{s}</div>
    ))}
  </div>
  
<div class="side-box" data-linkback>
  <div class="side-box-title">my button</div>
  <div class="side-box-body mybutton-body">
<button class="badge-slot" type="button" data-copy-embed aria-label="Copy my button embed code">
  <img class="badge-slot-img" src={buttonGif} width="88" height="31" alt={altText} />
</button>

    <script define:vars={{ embedCodeServer, buttonGif, hrefPath, altText }}>
      const box = document.querySelector("[data-linkback]");
      const btn = box?.querySelector("[data-copy-embed]");

      const origin = window.location.origin.replace(/\/$/, "");
      const imgAbs = new URL(buttonGif, origin).toString();
      const hrefAbs = origin + hrefPath;

      const embedCode =
        embedCodeServer ??
        (`<a href="${hrefAbs}" target="_blank" rel="noreferrer">` +
         `<img src="${imgAbs}" width="88" height="31" alt="${altText}" />` +
         `</a>`);

      async function copyText(text) {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.left = "-9999px";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }

      btn?.addEventListener("click", async () => {
        try {
          await copyText(embedCode);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 450);
        } catch {
          // intentionally silent
        }
      });
    </script>
  </div>
</div>

  <div class="buttonwall" aria-label="buttons">
    <Image src={nyan} alt="trans nyan" width={88} height={31} /> 
    <Image src={furry} alt="asswolf gif" width={88} height={31} />    <div class="btn88">static site</div>
    <Image src={trans} alt="trans rights now" width={88} height={31} />
    <Image src={flags} alt="rainbow Pan" width={88} height={31} />
    <div class="btn88">link me</div>
  </div>

  <div class="side-box">
    <div class="side-box-title">Webring</div>
    <a href="https://mangotreehouse.de" target="_blank"><img src="https://mangotreehouse.de/assets/mein-button.png" alt="Mango Tree House"></a>
    <div class="side-box-body">
      <div class="webringline">
        <a href="https://webring.dinhe.net/prev/https://adoptedbyegirl-indiewebpage.pages.dev/">← prev</a>
        <span class="sep">•</span>
        <a href="https://webring.dinhe.net/random">random</a>
        <span class="sep">•</span>
        <a href="https://webring.dinhe.net/next/https://adoptedbyegirl-indiewebpage.pages.dev/">next →</a>
      </div>
    </div>
  </div>
</div>