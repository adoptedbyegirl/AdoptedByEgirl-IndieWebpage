
---
const stamps = [
  "webcore",
  "made-by-hand",
  "purple-inside",
  "no-ai-feed",
  "my-site-my-rules",
  "best-with-tea",
  "still-wip",
  "touch-grass-later",
];
import { Image } from "astro:assets";
import furry from "../assets/asswolf_txt.gif";
import nyan from "../assets/nyan.png";
import flags from "../assets/flags.png";
---

<div class="side">
  <div class="side-title">Stamps & Stuff</div>
   <div class="side-box" id="np">
  <div class="side-box-title">Now playing</div>
  <div class="side-box-body">
    <div style="display:flex; gap:10px; align-items:center;">
      <img id="np-art" alt="" width="56" height="56"
           style="border:1px solid rgba(255,255,255,.18); background: rgba(0,0,0,.2); object-fit:cover;" />
      <div>
        <div id="np-title" style="font-weight:800;">—</div>
        <div id="np-artist" class="mono" style="opacity:.8;">offline</div>
      </div>
    </div>
    
  </div>
    <div class="statusbox">
    <div class="statusrow">
      <span class="led on" id="status-led" aria-hidden="true"></span>
      <span><strong>Status:</strong><span id="status-text">Online</span></span>
    </div>
  </div>
<script is:inline>
  const API = "https://nowplaying-worker.adoptedbyegirl.workers.dev/now";

  const widget = document.querySelector("[data-stamps-widget]");
  const statusRow = widget?.querySelector("[data-status-row]");
  const statusLed = widget?.querySelector("[data-status-led]");
  const statusText = widget?.querySelector("[data-status-text]");

  const title = widget?.querySelector("#np-title");
  const artist = widget?.querySelector("#np-artist");
  const art = widget?.querySelector("#np-art");

  const OFFLINE_AFTER_MS = 2 * 60 * 1000;

  // polling strategy
  const FAST_MS = 15000;     // while playing
  const SLOW_MS = 120000;    // while offline / paused
  const ERROR_MS = 180000;   // after network errors
  let nextDelay = SLOW_MS;

  // ETag caching
  let lastEtag = null;

  function setOffline() {
    statusText && (statusText.textContent = "Offline");
    statusLed && statusLed.classList.remove("on");
    statusRow && statusRow.classList.add("offline");

    title && (title.textContent = "—");
    artist && (artist.textContent = "offline");
    art && art.removeAttribute("src");
  }

  function setOnline() {
    statusText && (statusText.textContent = "Online");
    statusLed && statusLed.classList.add("on");
    statusRow && statusRow.classList.remove("offline");
  }

  async function tick() {
    // Don’t spam when tab is hidden
    if (document.visibilityState !== "visible") {
      nextDelay = SLOW_MS;
      schedule();
      return;
    }

    try {
      const headers = {};
      if (lastEtag) headers["If-None-Match"] = lastEtag;

      const res = await fetch(API, { cache: "no-store", headers });

      // 304 = unchanged, keep previous UI and slow/fast schedule stays
      if (res.status === 304) {
        schedule();
        return;
      }

      if (res.status === 204) {
        setOffline();
        nextDelay = SLOW_MS;
        schedule();
        return;
      }

      // update etag
      const etag = res.headers.get("ETag");
      if (etag) lastEtag = etag;

      const data = await res.json();

      const updatedAt = data.updatedAt ? Date.parse(data.updatedAt) : 0;
      const age = Date.now() - updatedAt;

      // treat stale as offline
      if (!updatedAt || age > OFFLINE_AFTER_MS) {
        setOffline();
        nextDelay = SLOW_MS;
        schedule();
        return;
      }

      // If you want offline unless actively playing:
      const playing = data.trackState === 1;

      if (!playing) {
        // paused = offline (your choice)
        setOffline();
        nextDelay = SLOW_MS;
        schedule();
        return;
      }

      // playing → online + faster updates
      setOnline();
      title && (title.textContent = data.title || "—");
      artist && (artist.textContent = data.artist || "");
      if (art && data.thumbnail) art.src = data.thumbnail;

      nextDelay = FAST_MS;
      schedule();
    } catch {
      // network/worker issues: back off hard
      setOffline();
      nextDelay = ERROR_MS;
      schedule();
    }
  }

  let timer = null;
  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(tick, nextDelay);
  }

  // when tab becomes visible, refresh quickly once
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      nextDelay = 0;
      schedule();
    }
  });

  // initial run
  tick();
</script>
</div>




  <div class="stampgrid" aria-label="stamps">
    {stamps.map((s) => (
      <div class="stamp">{s}</div>
    ))}
  </div>
  

  <div class="buttonwall" aria-label="buttons">
    <Image src={nyan} alt="trans nyan" width={88} height={31} /> 
    <Image src={furry} alt="asswolf gif" width={88} height={31} />    <div class="btn88">static site</div>
    <div class="btn88">purple</div>
    <Image src={flags} alt="rainbow Pan" width={88} height={31} />
    <div class="btn88">link me</div>
  </div>

  <div class="side-box">
    <div class="side-box-title">Webring</div>
    <a href="https://mangotreehouse.de" target="_blank"><img src="https://mangotreehouse.de/assets/mein-button.png" alt="Mango Tree House"></a>
    <div class="side-box-body">
      <div class="webringline">
        <a href="https://webring.dinhe.net/prev/https://adoptedbyegirl-indiewebpage.pages.dev/">← prev</a>
        <span class="sep">•</span>
        <a href="#">random</a>
        <span class="sep">•</span>
        <a href="https://webring.dinhe.net/next/https://adoptedbyegirl-indiewebpage.pages.dev/">next →</a>
      </div>
    </div>
  </div>
</div>